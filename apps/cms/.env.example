DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server-side only. Set on the CMS Production deployment to rebuild the frontend
# after content changes. Create this URL in the frontend Vercel project's
# Settings > Git > Deploy Hooks for the main branch. Leave empty to disable.
FRONTEND_DEPLOY_HOOK_URL=

# Server-side only. Obtain these from the Cloudinary console / API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=martasieczkowska
