---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import Header from '../components/organisms/header/header.astro'
import Footer from '../components/organisms/footer/footer.astro'
import ThumbnailsGrid from '../components/organisms/thumbnails-grid/thumbnails-grid.astro'
import BackwardForwardNavigation from '../components/organisms/backward-forward-navigation/backward-forward-navigation.astro'
import IconClickable from '../components/atoms/icon-clickable/icon-clickable.astro'
import ArrowUp from '../components/atoms/icons/arrow-up.astro'
import { getWorks, getThumbnails } from '../lib/works'
import { getCanonicalURL, getSocialImage, type SocialImage } from '../lib/seo'

interface Props {
	metatitle: string
	metadescription: string
	socialImage?: SocialImage | null
	isWithBackwordForwardNavigation?: boolean
	isWithArrows?: boolean
}

const { isWithBackwordForwardNavigation=true, isWithArrows=true, metatitle, metadescription, socialImage } = Astro.props
const works = await getWorks(import.meta.env.CMS_URL)
const thumbnailItemsList = getThumbnails(works)
const title = `Marta Sieczkowska | ${metatitle}`
const sourceImage = socialImage ?? works[0]?.thumbnail.image
const sharingImage = sourceImage ? getSocialImage(sourceImage) : undefined
const canonicalURL = getCanonicalURL(Astro.url.pathname, Astro.site ?? Astro.url)
const currentSlug = Astro.url.pathname.match(/^\/works\/([^/]+)\/?$/)?.[1]
const currentIndex = thumbnailItemsList.findIndex(item => item.slug === currentSlug)
const previousSlug = currentIndex > 0 ? thumbnailItemsList[currentIndex - 1].slug : undefined
const nextSlug = currentIndex >= 0 ? thumbnailItemsList[currentIndex + 1]?.slug : undefined
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<!-- Google tag (gtag.js) -->
		<script is:inline async src='https://www.googletagmanager.com/gtag/js?id=G-DR2M3HYVCW'></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){window.dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-DR2M3HYVCW');
		</script>
		<meta name='viewport' content='width=device-width' />
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
		<meta name='generator' content={Astro.generator} />
		<meta name='description' content={metadescription} />
		<title>{title}</title>
		<link rel='canonical' href={canonicalURL} />
		<meta property='og:title' content={title} />
		<meta property='og:description' content={metadescription} />
		<meta property='og:type' content='website' />
		<meta property='og:site_name' content='Marta Sieczkowska' />
		<meta property='og:url' content={canonicalURL} />
		<meta name='twitter:card' content={sharingImage ? 'summary_large_image' : 'summary'} />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={metadescription} />
		{sharingImage && <>
			<meta property='og:image' content={sharingImage.url} />
			<meta property='og:image:width' content={String(sharingImage.width)} />
			<meta property='og:image:height' content={String(sharingImage.height)} />
			<meta property='og:image:alt' content={sharingImage.alt} />
			<meta name='twitter:image' content={sharingImage.url} />
			<meta name='twitter:image:alt' content={sharingImage.alt} />
		</>}
		<ClientRouter />
	</head>
	<body class='flex flex-col spacing site-container'>
		<Header className='mb-2' />
		<slot />
		{isWithBackwordForwardNavigation? <BackwardForwardNavigation isWithArrows={isWithArrows} previousUrl={previousSlug ? `/works/${previousSlug}` : '/'} nextUrl={nextSlug ? `/works/${nextSlug}` : '/'}/> : null}
		<ThumbnailsGrid thumbnailItemsList={thumbnailItemsList}/>
		<Footer />
		<IconClickable
			target='_self'
			url='#header'
			ariaLabel='Back to top'
			className='icon-clickable sticky bottom-70 self-end lg:right-10 z-20 hidden p-1 rounded-full bg-white/60 -mr-4 lg:mr-4'
			data-back-to-top
		>
			<ArrowUp className='size-10'/>
		</IconClickable>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
  scroll-behavior: smooth;
	}
</style>

<script>
	let removeBackToTopScrollListener: (() => void) | undefined

	function initBackToTopButton() {
		removeBackToTopScrollListener?.()

		const iconClickable = document.querySelector<HTMLElement>('[data-back-to-top]')

		if (!iconClickable) {
			return
		}

		const toggleBackToTopButton = () => {
			iconClickable.classList.toggle('hidden', window.scrollY < 500)
		}

		toggleBackToTopButton()
		window.addEventListener('scroll', toggleBackToTopButton, { passive: true })

		removeBackToTopScrollListener = () => {
			window.removeEventListener('scroll', toggleBackToTopButton)
		}
	}

	initBackToTopButton()
	document.addEventListener('astro:page-load', initBackToTopButton)
</script>
