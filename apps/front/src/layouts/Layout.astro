---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import Header from '../components/organisms/header/header.astro'
import Footer from '../components/organisms/footer/footer.astro'
import ThumbnailsGrid from '../components/organisms/thumbnails-grid/thumbnails-grid.astro'
import { thumbnailItemsList } from '../data/projects-mock'

interface Props {
	metatitle?: string
	metadescription?: string
}

const { metatitle = 'test', metadescription = 'test' } = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<meta name='description' content={metadescription} />
		<title>Marta Sieczkowska | {metatitle}</title>
		<ClientRouter />
	</head>
	<body class='flex flex-col gap-4 site-container'>
		<Header className='mb-8' />
		<slot />
		<ThumbnailsGrid thumbnailItemsList={thumbnailItemsList} />
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
