---
import { cn } from '../../../lib/cn'
import GalleryRow, { type GalleryRowProps } from '../../molecules/gallery-row/gallery-row.astro'
import FullSizeImage from '../../molecules/full-size-image/full-size-image.astro'

export interface ProjectGalleryProps {
	className?: string
	galleryRows: GalleryRowProps[]
}

const { className, galleryRows } = Astro.props as ProjectGalleryProps
---

<div class={cn('flex w-full flex-col justify-start spacing', className)} id='project-gallery'>
	{galleryRows.map((row) => <GalleryRow {...row} />)}
</div>
<FullSizeImage />
