---
import ThumbnailItem from '../../molecules/thumbnail-item/thumbnail-item.astro'
import { type ContentImageProps } from '../../atoms/content-image/content-image.astro'

interface ThumbnailItem {
	slug: string
	category?: string
	image: ContentImageProps
	titleLines: string[]
	className?: string
}

interface Props {
	thumbnailItemsList: ThumbnailItem[]
}

const { thumbnailItemsList } = Astro.props
---

{
	thumbnailItemsList.length > 0 ? (
		<div class='grid grid-cols-2 pb-16 spacing' id='thumbnails-grid'>
			{thumbnailItemsList.map(thumbnail => <ThumbnailItem {...thumbnail} />)}
		</div>
	) : (
		null
	)
}
<p class='pb-16' data-portfolio-empty hidden={thumbnailItemsList.length > 0}>Sorry, no data to show yet.</p>

<style is:global>
  [data-work-slug][hidden], [data-portfolio-empty][hidden],
  [data-project-previous][hidden], [data-project-next][hidden] { display: none !important; }
</style>
