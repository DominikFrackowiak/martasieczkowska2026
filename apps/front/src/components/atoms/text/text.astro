---
import { cn } from '../../../lib/cn'

const variants = {
	regularText: 'text-base',
	navItem: 'nav-element text-base',
	caption: 'text-xs',
	thumbnail: 'justify-center items-start gap-0 text-base md:text-2xl font-normal text-white',
	project: 'text-3xl font-bold',
} as const

type TextVariant = keyof typeof variants

interface Props {
	className?: string
	as?: 'p' | 'span' | 'caption'
	variant?: TextVariant
	
}

const { as = 'p', className, textLines, variant = 'regularText' } = Astro.props as Props

const ElementHTML = as
---

<ElementHTML class={cn('font-serif', variants[variant], className)}>
	<slot />
</ElementHTML>
