---
import ContentImage from './content-image.astro'

export type ContentImageVariant = 'full' | 'grow' | '1/2' | '1/3' | '2/3' | '1/4' | '3/4' | '1/5' | '2/5' | '3/5' | '4/5'
export type ContentImageAlign = 'start' | 'center' | 'end'

export interface ContentImageProps {
	alt: string
	src: string
	intrinsicWidth: number | `${number}`
	intrinsicHeight: number | `${number}`
	align?: ContentImageAlign
	className?: string
	variant?: ContentImageVariant
}

const { alt, src, intrinsicWidth, intrinsicHeight, align, className, variant = 'full' } = Astro.props as ContentImageProps
---

<div class='flex min-h-screen w-full flex-col bg-white p-8'>
	<ContentImage
		alt={alt}
		src={src}
		intrinsicWidth={intrinsicWidth}
		intrinsicHeight={intrinsicHeight}
		variant={variant}
		align={align}
		className={className}
	/>
</div>