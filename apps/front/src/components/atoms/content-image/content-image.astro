---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { cn } from '../../../lib/cn'
import { cloudinaryImageURL } from '../../../lib/cloudinary'
import Text from '../text/text.astro'

const variants = {
	full: 'w-full',
	grow: 'flex-1',
	'1/2': 'w-1/2',
	'1/3': 'w-1/3',
	'2/3': 'w-2/3',
	'1/4': 'w-1/4',
	'3/4': 'w-3/4',
	'1/5': 'w-1/5',
	'2/5': 'w-2/5',
	'3/5': 'w-3/5',
	'4/5': 'w-4/5',
} as const

export type ContentImageVariant = keyof typeof variants

export interface ContentImageProps {
	alt: string
	src: ImageMetadata | string
	intrinsicWidth: number | `${number}`
	intrinsicHeight: number | `${number}`
	className?: string
	variant?: ContentImageVariant
	caption?: string
	sizes?: string
}

const { alt, caption, src, intrinsicWidth, intrinsicHeight, className, variant = 'full', sizes } = Astro.props as ContentImageProps
// Remote URLs go straight to their host; Astro optimizes local image imports.
const remoteSrc = typeof src === 'string' ? cloudinaryImageURL(src, Number(intrinsicWidth)) : undefined
const imageProps = {
	alt,
	width: intrinsicWidth,
	height: intrinsicHeight,
	class: cn('h-auto min-w-0 w-full', !caption && variants[variant], className),
	loading: 'lazy' as const,
	decoding: 'async' as const,
	sizes,
}
---

{caption ? (
	<figure class={cn('flex min-w-0 flex-col gap-1', variants[variant])}>
		{typeof src === 'string' ? <img {...imageProps} src={remoteSrc} /> : <Image {...imageProps} src={src} />}
		<Text as='figcaption' variant='caption'>{caption}</Text>
	</figure>
) : (
	typeof src === 'string' ? <img {...imageProps} src={remoteSrc} /> : <Image {...imageProps} src={src} />
)}
