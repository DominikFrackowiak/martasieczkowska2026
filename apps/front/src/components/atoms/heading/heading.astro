---
import { cn } from '../../../lib/cn'

const variants = {
	thumbnail: 'text-2xl font-normal',
	project: 'text-3xl font-bold',
} as const

type HeadingVariant = keyof typeof variants

interface Props {
	className?: string
	as: 'h1' | 'h2' | 'h3' | 'h4' | 'h5'
	variant?: HeadingVariant
}

const { as, className, variant = 'project' } = Astro.props as Props

const ElementHTML = as
---

<ElementHTML class={cn('flex flex-col gap-0.5 font-serif ', variants[variant], className)}>
	<slot/>
</ElementHTML>
