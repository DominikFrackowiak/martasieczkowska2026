---
interface Props {
	url: string
	target?: '_blank' | '_self' | '_parent' | '_top'
	ariaLabel: string
	className?: string
	as?: 'button' | 'a'
	[key: string]: unknown
}

const { ariaLabel, as = 'a', className, target = '_blank', url, ...props } = Astro.props

const ElementHTML = as
---

<ElementHTML
	{...props}
	href={url}
	target={target}
	rel={target === '_blank' ? 'noreferrer' : undefined}
	aria-label={ariaLabel}
	class={className}
>
	<slot />
</ElementHTML>
