---
import Layout from '../layouts/Layout.astro'
import Text from '../components/atoms/text/text.astro'
import Experience from '../components/molecules/experience/experience.astro'
import ContentImage from '../components/atoms/content-image/content-image.astro'
import { fetchAbout, getPortrait } from '../lib/about'

const about = await fetchAbout(import.meta.env.CMS_URL)
const portrait = getPortrait(about.portrait)
const textLines = about.experience.map(({ text, suffix }) => suffix ? [text, suffix] : text)
---

<Layout isWithArrows={false} metatitle={about.seo.metaTitle} metadescription={about.seo.metaDescription} socialImage={about.seo.socialImage ?? about.portrait.image}>
 <Text className='w-full max-w-127.5'>{about.introduction}</Text>
 <Experience textLines={textLines}/>
 <div>
 {about.paragraphs.map(({ text }) => <Text className='w-full max-w-127.5'>{text}</Text>)}
</div>
<ContentImage alt={portrait.alt} caption={portrait.caption} intrinsicHeight={portrait.height} intrinsicWidth={portrait.width} src={portrait.src} variant='1/5'/>
 <div>
 <Text className='w-full max-w-127.5'>
  {about.contactLabel}
 </Text>
 <Text className='w-full max-w-127.5'>{about.email}</Text>
</div>
</Layout>
