---
import { getWorks, getProject, type Project } from '../../lib/works'
import Layout from '../../layouts/Layout.astro'
import ProjectGallery from '../../components/organisms/project-gallery/project-gallery.astro'
import ProjectIntro from '../../components/molecules/project-intro/project-intro.astro'

export async function getStaticPaths() {
	const works = await getWorks(import.meta.env.CMS_URL)
	return works.map(work => ({
		params: { slug: work.slug },
		props: { project: getProject(work) },
	}))
}

const { project } = Astro.props as { project: Project }
---

<Layout metatitle={project.seo.metaTitle} metadescription={project.seo.metaDescription} socialImage={project.socialImage}>
	<div class='flex flex-col xl:flex-row justify-between gap-4'>
		<ProjectIntro
			className='order-0 xl:order-1 w-full xl:max-w-62.5'
			headingLines={project.intro.headingLines}
			descriptionParagraphs={project.intro.descriptionParagraphs}
		/>
		<ProjectGallery
			className='order-1 xl:order-0 w-full xl:max-w-181'
			galleryRows={project.galleryRows}
		/>
	</div>
</Layout>
