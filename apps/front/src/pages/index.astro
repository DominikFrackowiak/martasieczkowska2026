---
import Layout from '../layouts/Layout.astro'
import { fetchMain } from '../lib/main'

const main = await fetchMain(import.meta.env.CMS_URL)
---

<Layout isWithBackwordForwardNavigation={false} metatitle={main.seo.metaTitle} metadescription={main.seo.metaDescription} socialImage={main.seo.socialImage} />
